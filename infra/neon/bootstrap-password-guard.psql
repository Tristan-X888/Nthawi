-- Included by bootstrap.psql after the four role secrets are loaded from the
-- environment and before any transaction or role change. Only boolean results
-- are kept, nothing is echoed, and ON_ERROR_STOP aborts the whole bootstrap.

SELECT :'migrator_password' <> ''
   AND :'auth_password' <> ''
   AND :'business_password' <> ''
   AND :'jobs_password' <> '' AS passwords_supplied \gset

\if :passwords_supplied
\else
DO $passwords$
BEGIN
  RAISE EXCEPTION 'Set all DATABASE_{MIGRATOR,AUTH,BUSINESS,JOBS}_PASSWORD environment variables';
END
$passwords$;
\endif

-- One leaked runtime secret must never authenticate as another role, in
-- particular the DDL-owning migrator. Compare every pair.
SELECT :'migrator_password' NOT IN (:'auth_password', :'business_password', :'jobs_password')
   AND :'auth_password' NOT IN (:'business_password', :'jobs_password')
   AND :'business_password' <> :'jobs_password' AS passwords_distinct \gset

\if :passwords_distinct
\else
DO $distinct$
BEGIN
  RAISE EXCEPTION 'Each DATABASE_{MIGRATOR,AUTH,BUSINESS,JOBS}_PASSWORD must be different';
END
$distinct$;
\endif
