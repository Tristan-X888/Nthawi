{
  "name": "@nthawi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:provision-runtime": "node scripts/provision-runtime.mjs",
    "test": "pnpm build && node --test test/database.test.ts",
    "test:integration": "pnpm build && node --test test/*.integration.test.ts test/tenant-rls.test.ts",
    "db:manifest:update": "node scripts/schema-manifest.mjs --write",
    "db:manifest:check": "node scripts/schema-manifest.mjs",
    "build": "node scripts/schema-manifest.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/schema-manifest.mjs && tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/auth": {
      "types": "./dist/schema/auth.d.ts",
      "default": "./dist/schema/auth.js"
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11"
  }
}
